{
  "name": "warehouse-stock",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:https": "next dev --hostname 0.0.0.0 --experimental-https --experimental-https-key certificates/local-key.pem --experimental-https-cert certificates/local.pem",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env.test --import tsx --test tests/integration/*.test.ts",
    "user:create": "node --env-file=.env.local --import tsx scripts/create-user.ts",
    "test:http": "node --env-file=.env.test --import tsx tests/http/smoke.ts",
    "test:migration": "node --env-file=.env.test --import tsx --test tests/migrations/*.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.0",
    "next": "16.3.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
