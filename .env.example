DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=warehouse_stock
APP_URL=http://localhost:3000
# Tambahkan origin HP HTTPS/LAN, dipisahkan koma; jangan pakai wildcard.
